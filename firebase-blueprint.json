{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public student profile metadata without sensitive PII",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the student owner",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Display name of the student",
          "minLength": 1,
          "maxLength": 100
        },
        "university": {
          "type": "string",
          "description": "University or institution name",
          "minLength": 0,
          "maxLength": 150
        },
        "major": {
          "type": "string",
          "description": "Academic major or field of study",
          "minLength": 0,
          "maxLength": 150
        },
        "photoUrl": {
          "type": "string",
          "description": "Avatar photo URL",
          "minLength": 0,
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp"
        }
      },
      "required": ["uid", "displayName", "createdAt", "updatedAt"]
    },
    "UserPrivate": {
      "title": "UserPrivate",
      "description": "Isolated private student PII record containing email address",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the owner",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified student email address",
          "minLength": 3,
          "maxLength": 254
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": ["uid", "email", "createdAt", "updatedAt"]
    },
    "Subject": {
      "title": "Subject",
      "description": "Academic course or subject managed by a student",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID of the student who owns this subject",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Subject title",
          "minLength": 1,
          "maxLength": 120
        },
        "code": {
          "type": "string",
          "description": "Course code identifier",
          "minLength": 0,
          "maxLength": 40
        },
        "color": {
          "type": "string",
          "description": "Theme color hex or token",
          "minLength": 0,
          "maxLength": 32
        },
        "description": {
          "type": "string",
          "description": "Course overview description",
          "minLength": 0,
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": ["ownerId", "name", "createdAt", "updatedAt"]
    },
    "StudyNote": {
      "title": "StudyNote",
      "description": "Cloud-synced study note belonging to a specific subject and student",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID of the student author",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "subjectId": {
          "type": "string",
          "description": "Parent Subject document ID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Study note title",
          "minLength": 1,
          "maxLength": 200
        },
        "content": {
          "type": "string",
          "description": "Markdown study note content",
          "minLength": 1,
          "maxLength": 20000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": ["ownerId", "subjectId", "title", "content", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Student profile documents keyed by Firebase Auth UID"
    },
    "/users/{userId}/private/{docId}": {
      "schema": "UserPrivate",
      "description": "Isolated PII document (docId == 'info') restricted strictly to the owner"
    },
    "/subjects/{subjectId}": {
      "schema": "Subject",
      "description": "Academic subjects owned by students"
    },
    "/studyNotes/{noteId}": {
      "schema": "StudyNote",
      "description": "Cloud-synced student study notes linked to subjects"
    }
  }
}
