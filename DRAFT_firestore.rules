rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Primitive Helpers
    // =========================================================================
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // =========================================================================
    // Entity Validation Blueprints (Anti-Update-Gap)
    // =========================================================================
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'university', 'major', 'photoUrl', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == request.auth.uid &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        (!('university' in data) || (data.university is string && data.university.size() <= 150)) &&
        (!('major' in data) || (data.major is string && data.major.size() <= 150)) &&
        (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidUserPrivate(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == request.auth.uid &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        data.email == request.auth.token.email &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidSubject(data) {
      return data.keys().hasAll(['ownerId', 'name', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'name', 'code', 'color', 'description', 'createdAt', 'updatedAt']) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        (!('code' in data) || (data.code is string && data.code.size() <= 40)) &&
        (!('color' in data) || (data.color is string && data.color.size() <= 32)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidStudyNote(data) {
      return data.keys().hasAll(['ownerId', 'subjectId', 'title', 'content', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'subjectId', 'title', 'content', 'createdAt', 'updatedAt']) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.subjectId is string && data.subjectId.size() >= 1 && data.subjectId.size() <= 128 && data.subjectId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.content is string && data.content.size() >= 1 && data.content.size() <= 20000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time;
    }

    // =========================================================================
    // Collection Rules
    // =========================================================================

    // 1. UserProfile (/users/{userId})
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;

      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        isValidUserProfile(incoming()) &&
        incoming().createdAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        (
          // Action: UpdateProfileMetadata
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'university', 'major', 'photoUrl', 'updatedAt'])
        );

      allow delete: if isVerifiedUser() && isValidId(userId) && request.auth.uid == userId;

      // 2. UserPrivate PII Isolation (/users/{userId}/private/{docId})
      match /private/{docId} {
        allow get: if isSignedIn() && isValidId(userId) && docId == 'info' && request.auth.uid == userId;
        allow list: if false;

        allow create: if isVerifiedUser() &&
          isValidId(userId) &&
          docId == 'info' &&
          request.auth.uid == userId &&
          isValidUserPrivate(incoming()) &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isVerifiedUser() &&
          isValidId(userId) &&
          docId == 'info' &&
          request.auth.uid == userId &&
          isValidUserPrivate(incoming()) &&
          incoming().uid == existing().uid &&
          incoming().createdAt == existing().createdAt &&
          (
            // Action: SyncVerifiedEmail
            incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt'])
          );

        allow delete: if isVerifiedUser() && isValidId(userId) && docId == 'info' && request.auth.uid == userId;
      }
    }

    // 3. Academic Subjects (/subjects/{subjectId})
    match /subjects/{subjectId} {
      allow get: if isSignedIn() && isValidId(subjectId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;

      allow create: if isVerifiedUser() &&
        isValidId(subjectId) &&
        isValidSubject(incoming()) &&
        incoming().createdAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidId(subjectId) &&
        isValidSubject(incoming()) &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        (
          // Action: EditSubjectDetails
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'code', 'color', 'description', 'updatedAt'])
        );

      allow delete: if isVerifiedUser() &&
        isValidId(subjectId) &&
        existing().ownerId == request.auth.uid;
    }

    // 4. Cloud Study Notes (/studyNotes/{noteId})
    match /studyNotes/{noteId} {
      allow get: if isSignedIn() && isValidId(noteId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;

      allow create: if isVerifiedUser() &&
        isValidId(noteId) &&
        isValidStudyNote(incoming()) &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/subjects/$(incoming().subjectId)) &&
        get(/databases/$(database)/documents/subjects/$(incoming().subjectId)).data.ownerId == request.auth.uid;

      allow update: if isVerifiedUser() &&
        isValidId(noteId) &&
        isValidStudyNote(incoming()) &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().subjectId == existing().subjectId &&
        incoming().createdAt == existing().createdAt &&
        exists(/databases/$(database)/documents/subjects/$(existing().subjectId)) &&
        get(/databases/$(database)/documents/subjects/$(existing().subjectId)).data.ownerId == request.auth.uid &&
        (
          // Action: EditStudyNoteContent
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'updatedAt'])
        );

      allow delete: if isVerifiedUser() &&
        isValidId(noteId) &&
        existing().ownerId == request.auth.uid;
    }
  }
}
